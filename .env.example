# Copy to .env and edit. Every value has a working default, so an empty file is fine.

# Where the interface is published. The default binds to the loopback interface only, on the
# assumption that a reverse proxy sits in front; use 0.0.0.0 to reach it from your network.
#LIFELINE_BIND=127.0.0.1
#LIFELINE_PORT=8000

# The user the container runs as. It must own ./data.
#LIFELINE_UID=1000
#LIFELINE_GID=1000

# Timezone for log timestamps.
#TZ=Europe/Amsterdam

# Guards the first-run wizard. Unset, one is generated and printed to the container log:
#   docker compose logs lifeline
# Set to `off` only where nobody else can reach the interface.
#SETUP_TOKEN=

# Encrypts the stored sessions. Unset, one is generated into ./data/secret.key on first
# boot. Losing it means logging into every site again.
#SECRET_KEY=

#LOG_LEVEL=INFO

# Only needed on a network that proxies npm, and only to install the interface's packages:
# the image build does that, and so does the Vite container `make dev` starts. The lockfile
# records the public registry, which is what CI and most people reach; set this to your mirror
# if your network does not. Nothing the running application does goes through it, and `make
# dev` fills it in from your own npm configuration if you leave it unset.
#NPM_REGISTRY=https://npm.example.org/
